# Secrets and machine-specific settings only.
# All behavioural / block configuration lives in config.json (see config.example.json).

# Required: OpenAI key (used for TTS, and for the LLM stage unless overridden in config.json).
OPENAI_API_KEY=your_openai_api_key_here

# Required for upload: Google Cloud Storage bucket the briefing is published to.
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# Optional: only needed if you flip config.json -> llm.api_key_env to OPENROUTER_API_KEY.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
